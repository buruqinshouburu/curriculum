              "body": "{\n  \"code\": 200,\n  \"msg\": \"操作成功\",\n  \"data\": [\n    {\n      \"id\": 11,\n      \"content\": \"具有良好的人文素养\",\n      \"level\": 1\n    }\n  ]\n}"
