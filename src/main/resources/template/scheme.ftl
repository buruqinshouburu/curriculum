            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
                <w:t>备注：培养目标主要对学员毕业后5年左右能够达到的职业和专业成就进行宏观描述，应体现立德树人、服务面向、人才层次，重点回答为谁培养人、培养成什么样的人。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="561"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:kern w:val="0"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:kern w:val="0"/>
                </w:rPr>
                <w:t>本培养方案适用于生长军官本科学员${wildcard}、${wildcard}、${wildcard}、${wildcard}专业本科学历教育。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:b/>
                    <w:bCs/>
                </w:rPr>
                <w:t>1. 总体目标。</w:t>
            </w:r>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>培养“对党绝对忠诚、科技基础厚实、创新思维敏锐、军事素质过硬、作风纪律优良”的高素质专业化新型军事人才，为造就通晓战争的科技专家和掌握科技的军事专家奠定坚实基础。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:b/>
                    <w:bCs/>
                </w:rPr>
                <w:t>2. 具体目标。</w:t>
            </w:r>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>立足${wildcard}行业发展需求，面向${wildcard}领域，培养德、智、体、美、劳全面发展，具有扎实的${wildcard}知识，具备${wildcard}能力，具备坚定的政治素质、过硬的军事素质、优秀的科技素质、深厚的人文素质和健康的心理素质，能够在${wildcard}行业胜任${wildcard}等岗位，从事${wildcard}工作的${wildcard}高素质${wildcard}人才。</w:t>
            </w:r>
        </w:p>

        <w:p>
