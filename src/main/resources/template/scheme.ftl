            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="561"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
                <w:t>备注：基础科学知识是学生形成科学思维、掌握科学方法、树立科学精神的基础性知识要素。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>1. 掌握数学、物理、化学、生命科学等基础科学知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>2. 掌握工程科学、信息科学、管理科学、行为科学等交叉科学知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
