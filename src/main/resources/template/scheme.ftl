                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:b/>
                    <w:bCs/>
                </w:rPr>
                <w:t>1.1 通识课程知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="561"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
                <w:t>备注：知识要求中的通识课程知识不应仅限于通识课程中设置的知识内容，应将通识育人的理念贯穿人才培养全过程，涵盖通识教育课程、公共基础课程、通识选修课程以及第二课堂等各类课程中蕴含的知识要素。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                    <w:b/>
                    <w:bCs/>
                </w:rPr>
                <w:t>1.1.1 政治理论知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>1. 掌握马克思主义基本原理、毛泽东思想、邓小平理论、“三个代表”重要思想、科学发展观、习近平新时代中国特色社会主义思想等理论知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
                <w:t>2. 掌握中国共产党历史、新中国史、改革开放史、社会主义发展史、中华民族发展史等理论知识。</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="473"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:cs="宋体"/>
                </w:rPr>
