            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="黑体" w:eastAsia="黑体"/>
                    <w:sz w:val="28"/>
                    <w:szCs w:val="28"/>
                </w:rPr>
                <w:t>1. 知识要求</w:t>
            </w:r>
        </w:p>

        <w:p>
            <w:pPr>
                <w:ind w:firstLine="561"/>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
            </w:pPr>
            <w:r>
                <w:rPr>
                    <w:rFonts w:hint="eastAsia" w:ascii="仿宋_GB2312" w:hAnsi="仿宋_GB2312" w:eastAsia="仿宋_GB2312" w:cs="仿宋_GB2312"/>
                    <w:kern w:val="0"/>
                </w:rPr>
                <w:t>备注：知识要求为本专业学生应学习和掌握的知识体系，包括公共基础课程、专业基础课程、专业课程、军事综合课程等知识模块。</w:t>
            </w:r>
        </w:p>

