<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agileai.dataparser.mapper.CurTrainingProgramMapper">

    <cache type="org.apache.ibatis.cache.impl.PerpetualCache" eviction="lru" flushInterval="12000000" size="1024" readOnly="false"/>

    <resultMap type="CurTrainingProgram" id="CurTrainingProgramResult">
        <result property="id"    column="ID"    />
        <result property="teachingPlanId"    column="TEACHING_PLAN_ID"    />
        <result property="parentId"    column="PARENT_ID"    />
        <result property="name"    column="NAME"    />
        <result property="orderNum"    column="ORDER_NUM"    />
        <result property="fileId"    column="FILE_ID"    />
        <result property="fileName"    column="FILE_NAME"    />
        <result property="college"    column="COLLEGE"    />
        <result property="type"    column="TYPE"    />
    </resultMap>

    <sql id="selectCurTrainingProgramVo">
        select ID, TEACHING_PLAN_ID, NAME, ORDER_NUM, FILE_ID, FILE_NAME, COLLEGE, PARENT_ID, TYPE from cur_training_program
    </sql>

    <select id="selectCurTrainingProgramList" parameterType="CurTrainingProgram" resultMap="CurTrainingProgramResult">
        <include refid="selectCurTrainingProgramVo"/>
        <where>
            <if test="teachingPlanId != null "> and TEACHING_PLAN_ID = #{teachingPlanId}</if>
            <if test="name != null  and name != ''"> and NAME like concat('%', #{name}, '%')</if>
            <if test="orderNum != null "> and ORDER_NUM = #{orderNum}</if>
            <if test="fileId != null  and fileId != ''"> and FILE_ID = #{fileId}</if>
            <if test="fileName != null  and fileName != ''"> and FILE_NAME like concat('%', #{fileName}, '%')</if>
            <if test="college != null  and college != ''"> and COLLEGE = #{college}</if>
            <if test="type != null"> and TYPE = #{type}</if>
            <if test="parentId != null"> and PARENT_ID = #{parentId}</if>
        </where>
    </select>

    <select id="selectCurTrainingProgramTree" parameterType="CurTrainingProgram" resultMap="CurTrainingProgramResult">
        <include refid="selectCurTrainingProgramVo"/>
        <where>
            <if test="teachingPlanId != null "> and TEACHING_PLAN_ID = #{teachingPlanId}</if>
            <if test="parentId != null"> and PARENT_ID = #{parentId}</if>
            <if test="name != null  and name != ''"> and NAME like concat('%', #{name}, '%')</if>
            <if test="orderNum != null "> and ORDER_NUM = #{orderNum}</if>
            <if test="fileId != null  and fileId != ''"> and FILE_ID = #{fileId}</if>
            <if test="fileName != null  and fileName != ''"> and FILE_NAME like concat('%', #{fileName}, '%')</if>
            <if test="college != null  and college != ''"> and (COLLEGE = #{college} or COLLEGE IS NULL)</if>
            <if test="type != null"> and TYPE = #{type}</if>
        </where>
        group by id
    </select>

    <select id="selectCurTrainingProgramById" parameterType="Long" resultMap="CurTrainingProgramResult">
        <include refid="selectCurTrainingProgramVo"/>
        where ID = #{id}
    </select>

    <insert id="insertCurTrainingProgram" parameterType="CurTrainingProgram" useGeneratedKeys="true" keyProperty="id">
        insert into cur_training_program
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teachingPlanId != null">TEACHING_PLAN_ID,</if>
            <if test="parentId != null">PARENT_ID,</if>
            <if test="name != null">NAME,</if>
            <if test="orderNum != null">ORDER_NUM,</if>
            <if test="fileId != null">FILE_ID,</if>
            <if test="fileName != null">FILE_NAME,</if>
            <if test="college != null">COLLEGE,</if>
            <if test="type != null">TYPE,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teachingPlanId != null">#{teachingPlanId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="name != null">#{name},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="fileId != null">#{fileId},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="college != null">#{college},</if>
            <if test="type != null">#{type},</if>
         </trim>
    </insert>

    <update id="updateCurTrainingProgram" parameterType="CurTrainingProgram">
        update cur_training_program
        <trim prefix="SET" suffixOverrides=",">
            <if test="teachingPlanId != null">TEACHING_PLAN_ID = #{teachingPlanId},</if>
            <if test="parentId != null">PARENT_ID = #{parentId},</if>
            <if test="name != null">NAME = #{name},</if>
            <if test="orderNum != null">ORDER_NUM = #{orderNum},</if>
            <if test="type != null">TYPE = #{type},</if>
            <if test="college != null">COLLEGE = #{college},</if>
            FILE_ID = #{fileId},
            FILE_NAME = #{fileName}
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteCurTrainingProgramById" parameterType="Long">
        delete from cur_training_program where ID = #{id}
    </delete>

    <delete id="deleteCurTrainingProgramByIds" parameterType="String">
        delete from cur_training_program where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectCurTrainingProgramByPlanningIds"  parameterType="String" resultMap="CurTrainingProgramResult">
        <include refid="selectCurTrainingProgramVo"/>
        where TEACHING_PLAN_ID in
        <foreach item="id" collection="teachingPlanIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectCurTrainingProgramByParentIds"  parameterType="String" resultMap="CurTrainingProgramResult">
        <include refid="selectCurTrainingProgramVo"/>
        where type = 1 and PARENT_ID in
        <foreach item="id" collection="parentIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <update id="resetId">
        alter table CUR_TRAINING_PROGRAM auto_increment = 1;
    </update>
</mapper>
