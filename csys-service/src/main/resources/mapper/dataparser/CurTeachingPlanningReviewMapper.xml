<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agileai.dataparser.mapper.CurTeachingPlanningReviewMapper">
    <resultMap id="CurTeachingPlanningReviewResult" type="CurTeachingPlanningReview">
        <result property="id"    column="ID"/>
        <result property="mainId"    column="MAIN_ID"/>
        <result property="review"    column="REVIEW"/>
        <result property="createBy"    column="CREATE_BY"/>
        <result property="createTime"    column="CREATE_TIME"/>
    </resultMap>

    <sql id="selectCurTeachingPlanningReviewVo">
        select ID, MAIN_ID, REVIEW, CREATE_BY, CREATE_TIME from cur_teaching_plannning_review
    </sql>

    <insert id="insertCurTeachingPlanningReview" parameterType="CurTeachingPlanningReview" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into cur_teaching_plannning_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="mainId != null">MAIN_ID,</if>
            <if test="review != null and review != ''">REVIEW,</if>
            <if test="createBy != null">CREATE_BY,</if>
            CREATE_TIME
        </trim>
        <trim prefix="values(" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="mainId != null">#{mainId},</if>
            <if test="review != null and review != ''">#{review},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <select id="selectCurTeachingPlanningReviews" parameterType="Long" resultMap="CurTeachingPlanningReviewResult">
        <include refid="selectCurTeachingPlanningReviewVo"/>
        where MAIN_ID = #{mainId}
        order by CREATE_TIME desc
    </select>

    <select id="selectCurTeachingPlanningReviewById" parameterType="Long" resultMap="CurTeachingPlanningReviewResult">
        <include refid="selectCurTeachingPlanningReviewVo"/>
        where ID = #{id}
    </select>

</mapper>