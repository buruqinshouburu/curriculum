         </trim>
    </insert>

    <insert id="insertCurTeachingPlanningBookList" parameterType="CurTeachingPlanningBook" useGeneratedKeys="true" keyProperty="id">
        <foreach collection="list" separator=";" item="item" index="index">
        insert into cur_teaching_plannning_book
