    <update id="updateCurTeachingPlanningBook" parameterType="CurTeachingPlanningBook">
        update cur_teaching_plannning_book
        <trim prefix="SET" suffixOverrides=",">
            <if test="mainId != null">MAIN_ID = #{mainId},</if>
            <if test="mainId == null">MAIN_ID = null,</if>
            <if test="name != null">NAME = #{name},</if>
