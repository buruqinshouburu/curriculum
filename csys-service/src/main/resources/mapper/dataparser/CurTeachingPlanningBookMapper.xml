<mapper namespace="com.agileai.dataparser.mapper.CurTeachingPlanningBookMapper">

    <resultMap type="CurTeachingPlanningBook" id="CurTeachingPlanningBookResult">
        <result property="id"    column="ID"    />
        <result property="mainId"    column="MAIN_ID"    />
        <result property="name"    column="NAME"    />
        <result property="type"    column="TYPE"    />
        <result property="autherName"    column="AUTHER_NAME"    />
        <result property="pubName"    column="PUB_NAME"    />
        <result property="version"    column="VERSION"    />
        <result property="pubTime"    column="PUB_TIME"    />
    </resultMap>

    <sql id="selectCurTeachingPlanningBookVo">
        select ID, MAIN_ID, NAME, TYPE,AUTHER_NAME,PUB_NAME,VERSION,PUB_TIME from cur_teaching_plannning_book
    </sql>

    <select id="selectCurTeachingPlanningBookList" parameterType="CurTeachingPlanningBook" resultMap="CurTeachingPlanningBookResult">
        <include refid="selectCurTeachingPlanningBookVo"/>
        <where>
            <if test="name != null  and name != ''"> and NAME like concat('%', #{name}, '%')</if>
            <if test="type != null  and type != ''"> and TYPE = #{type}</if>
        </where>
    </select>

    <select id="selectCurTeachingPlanningBookById" parameterType="Long" resultMap="CurTeachingPlanningBookResult">
        <include refid="selectCurTeachingPlanningBookVo"/>
        where ID = #{id}
    </select>

    <select id="selectCurTeachingPlanningBookByMainId" parameterType="Long" resultMap="CurTeachingPlanningBookResult">
        <include refid="selectCurTeachingPlanningBookVo"/>
        where MAIN_ID = #{mainId}
    </select>

    <insert id="insertCurTeachingPlanningBook" parameterType="CurTeachingPlanningBook" useGeneratedKeys="true" keyProperty="id">
        insert into cur_teaching_plannning_book
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="mainId != null">MAIN_ID,</if>
            <if test="name != null">NAME,</if>
            <if test="type != null">TYPE,</if>
            <if test="autherName != null">AUTHER_NAME,</if>
            <if test="pubName != null">PUB_NAME,</if>
            <if test="version != null">VERSION,</if>
            <if test="pubTime != null">PUB_TIME,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
