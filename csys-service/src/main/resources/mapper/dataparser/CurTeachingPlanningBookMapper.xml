            <if test="type == null">TYPE = null,</if>
            <if test="autherName != null">AUTHER_NAME = #{autherName},</if>
            <if test="autherName == null">AUTHER_NAME = null,</if>
            <if test="pubName != null">PUB_NAME = #{pubName},</if>
            <if test="pubName == null">PUB_NAME = null,</if>
            <if test="version != null">VERSION = #{version},</if>
            <if test="version == null">VERSION = null,</if>
            <if test="pubTime != null">PUB_TIME = #{pubTime},</if>
            <if test="pubTime == null">PUB_TIME = null,</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteCurTeachingPlanningBookById" parameterType="Long">
        delete from cur_teaching_plannning_book where ID = #{id}
    </delete>

    <delete id="deleteCurTeachingPlanningBookByIds" parameterType="Long">
        delete from cur_teaching_plannning_book where ID in
