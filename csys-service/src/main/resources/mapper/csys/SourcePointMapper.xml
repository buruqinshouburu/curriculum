<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doinner.csys.dao.SourcePointMapper">

    <resultMap type="SourcePoint" id="SourcePointResult">
            <result property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="createTime" column="create_time"/>
            <result property="creator" column="creator"/>
            <result property="lastModifiedTime" column="last_modified_time"/>
            <result property="lastModifier" column="last_modifier"/>
            <result property="remark" column="remark"/>
            <result property="sysflag" column="sysflag"/>
            <result property="deptBy" column="dept_by"/>
    </resultMap>

    <sql id="selectSourcePointVo">
        select id, name, create_time, creator, last_modified_time, last_modifier, remark, sysflag, dept_by
        from t_csys_source_point
    </sql>

    <select id="selectSourcePointList" parameterType="SourcePoint" resultMap="SourcePointResult">
        <include refid="selectSourcePointVo"/>
        <where>
                        <if test="name != null  and name != ''">
                            and name like concat('%', #{name}, '%')
                        </if>
                        <if test="lastModifiedTime != null ">
                            and last_modified_time = #{lastModifiedTime}
                        </if>
                        <if test="lastModifier != null  and lastModifier != ''">
                            and last_modifier = #{lastModifier}
                        </if>
                        <if test="sysflag != null  and sysflag != ''">
                            and sysflag = #{sysflag}
                        </if>
                        <if test="deptBy != null ">
                            and dept_by = #{deptBy}
                        </if>
        </where>
    </select>

    <select id="selectSourcePointById" parameterType="Long"
            resultMap="SourcePointResult">
            <include refid="selectSourcePointVo"/>
            where id = #{id}
    </select>

    <insert id="insertSourcePoint" parameterType="SourcePoint" useGeneratedKeys="true"
            keyProperty="id">
        insert into t_csys_source_point
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">
                name,
            </if>
            <if test="createTime != null">
                create_time,
            </if>
            <if test="creator != null">
                creator,
            </if>
            <if test="lastModifiedTime != null">
                last_modified_time,
            </if>
            <if test="lastModifier != null">
                last_modifier,
            </if>
            <if test="remark != null">
                remark,
            </if>
            <if test="sysflag != null and sysflag != ''">
                sysflag,
            </if>
            <if test="deptBy != null">
                dept_by,
            </if>
            <if test="type != null">
                type,
            </if>
            <if test="sourceId != null">
                source_id,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">
                #{name},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="creator != null">
                #{creator},
            </if>
            <if test="lastModifiedTime != null">
                #{lastModifiedTime},
            </if>
            <if test="lastModifier != null">
                #{lastModifier},
            </if>
            <if test="remark != null">
                #{remark},
            </if>
            <if test="sysflag != null and sysflag != ''">
                #{sysflag},
            </if>
            <if test="deptBy != null">
                #{deptBy},
            </if>
            <if test="type != null">
                #{type},
            </if>
            <if test="sourceId != null">
                #{sourceId},
            </if>
        </trim>
    </insert>

    <update id="updateSourcePoint" parameterType="SourcePoint">
        update t_csys_source_point
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">
                name =
                #{name},
            </if>
            <if test="createTime != null">
                create_time =
                #{createTime},
            </if>
            <if test="creator != null">
                creator =
                #{creator},
            </if>
            <if test="lastModifiedTime != null">
                last_modified_time =
                #{lastModifiedTime},
            </if>
            <if test="lastModifier != null">
                last_modifier =
                #{lastModifier},
            </if>
            <if test="remark != null">
                remark =
                #{remark},
            </if>
            <if test="sysflag != null and sysflag != ''">
                sysflag =
                #{sysflag},
            </if>
            <if test="deptBy != null">
                dept_by =
                #{deptBy},
            </if>
            <if test="type != null">
                type =
                #{type},
            </if>
            <if test="sourceId != null">
                source_id =
                #{sourceId},
            </if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSourcePointById" parameterType="Long">
        delete
        from t_csys_source_point where id = #{id}
    </delete>

    <delete id="deleteSourcePointByIds" parameterType="String">
        delete from t_csys_source_point where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
