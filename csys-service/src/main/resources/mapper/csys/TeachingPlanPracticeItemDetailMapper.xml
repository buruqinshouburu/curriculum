<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doinner.csys.dao.TeachingPlanPracticeItemDetailMapper">

    <resultMap id="BaseResultMap" type="com.doinner.csys.domain.TeachingPlanPracticeItemDetail">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="item_id" property="itemId" jdbcType="BIGINT"/>
        <result column="detail_type" property="detailType" jdbcType="VARCHAR"/>
        <result column="objective_id" property="objectiveId" jdbcType="BIGINT"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="sort" property="sort" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, item_id, detail_type, objective_id, content, sort
    </sql>

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO t_csys_teaching_plan_practice_item_detail (
            item_id, detail_type, objective_id, content, sort
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.itemId}, #{item.detailType}, #{item.objectiveId}, #{item.content}, #{item.sort}
            )
        </foreach>
    </insert>

    <select id="selectByItemId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_csys_teaching_plan_practice_item_detail
        WHERE item_id = #{itemId}
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectByItemIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_csys_teaching_plan_practice_item_detail
        WHERE item_id IN
        <foreach collection="itemIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY item_id ASC, sort ASC, id ASC
    </select>

    <delete id="deleteByItemId">
        DELETE FROM t_csys_teaching_plan_practice_item_detail WHERE item_id = #{itemId}
    </delete>

    <delete id="deleteByPlanId">
        DELETE d FROM t_csys_teaching_plan_practice_item_detail d
        INNER JOIN t_csys_teaching_plan_practice_item i ON d.item_id = i.id
        WHERE i.plan_id = #{planId}
    </delete>

    <insert id="insert" parameterType="com.doinner.csys.domain.TeachingPlanPracticeItemDetail"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_csys_teaching_plan_practice_item_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            <if test="detailType != null">detail_type,</if>
            <if test="objectiveId != null">objective_id,</if>
            <if test="content != null">content,</if>
            <if test="sort != null">sort,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            <if test="detailType != null">#{detailType},</if>
            <if test="objectiveId != null">#{objectiveId},</if>
            <if test="content != null">#{content},</if>
            <if test="sort != null">#{sort},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.doinner.csys.domain.TeachingPlanPracticeItemDetail">
        UPDATE t_csys_teaching_plan_practice_item_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="detailType != null">detail_type = #{detailType},</if>
            <if test="objectiveId != null">objective_id = #{objectiveId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, item_id, detail_type, objective_id, content, sort
        FROM t_csys_teaching_plan_practice_item_detail
        WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM t_csys_teaching_plan_practice_item_detail WHERE id = #{id}
    </delete>
</mapper>