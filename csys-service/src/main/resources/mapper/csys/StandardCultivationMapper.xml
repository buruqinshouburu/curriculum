    <insert id="insertStandardCultivationList" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        insert into t_csys_std_cultivation (name, code, parent_id, leaf, level, url, graduation_id, major_id, sub_major_id, class_id, college_id, remark,version) VALUES
        <foreach collection="standardCultivationList" item="standardCultivation" separator=",">
            (#{standardCultivation.name}, #{standardCultivation.code},
            #{standardCultivation.parentId}, #{standardCultivation.leaf},
            #{standardCultivation.level}, #{standardCultivation.url}, #{standardCultivation.graduationId},
            #{standardCultivation.majorId}, #{standardCultivation.subMajorId}, #{standardCultivation.classId},
            #{standardCultivation.collegeId}, #{standardCultivation.remark}, #{standardCultivation.version})
        </foreach>
    </insert>

    <update id="updateStandardCultivationList" parameterType="java.util.List">
        <foreach collection="standardCultivationList" item="standardCultivation" index="index" separator=";">
            update t_csys_std_cultivation AS cultivation
            set cultivation.parent_id = #{standardCultivation.parentId},
            cultivation.url = #{standardCultivation.url},
            cultivation.graduation_id = #{standardCultivation.graduationId},
            cultivation.leaf = #{standardCultivation.leaf},
            cultivation.level = #{standardCultivation.level}
            where cultivation.id = #{standardCultivation.id}
        </foreach>
    </update>

