    <sql id="selectStandardCultivationVo">
        select id, name, code, parent_id, leaf, graduation_id, level, url, college_id, major_id, sub_major_id, class_id, create_time, creator, last_modified_time, last_modifier, remark, sysflag,version from t_csys_std_cultivation
    </sql>
    <sql id="selectStandardGraduationRefTargetVo">
        SELECT sc.id,
               sc.`name`,
               sc.graduation_id,
               sc.`code`,
               sc.parent_id,
               sc.leaf,
               sc.`level`,
               sc.url,
               sc.college_id,
               sc.major_id,
               sc.sub_major_id,
               sc.class_id,
               sc.remark,
               sc.version,
               crg.graduation_id ref_g_id,
               crg.cultivation_id
        FROM t_csys_std_cultivation sc
                 LEFT JOIN t_csys_std_cultivation_ref_graduation crg ON sc.id = crg.cultivation_id
    </sql>
    <select id="selectStandardCultivationList" parameterType="com.doinner.csys.domain.StandardCultivation"
            resultMap="StandardCultivationResult">
        <include refid="selectStandardCultivationVo"/>
        where sysflag = 0
        <if test="name != null  and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="code != null  and code != ''">
            and code = #{code}
        </if>
        <if test="parentId != null">
            and parent_id = #{parentId}
        </if>
        <if test="leaf != null">
            and leaf = #{leaf}
        </if>
        <if test="level != null">
            and level = #{level}
        </if>
        <if test="url != null  and url != ''">
            and url = #{url}
        </if>
        <if test="collegeId != null">
            and college_id = #{collegeId}
        </if>
        <if test="majorId != null">
            and major_id = #{majorId}
        </if>
        <if test="subMajorId != null">
            and sub_major_id = #{subMajorId}
        </if>
        <if test="classId != null">
            and class_id = #{classId}
        </if>
        <if test="version != null">
            and version = #{version}
        </if>
    </select>

    <select id="selectStandardCultivationById" parameterType="Long" resultMap="StandardCultivationResult">
