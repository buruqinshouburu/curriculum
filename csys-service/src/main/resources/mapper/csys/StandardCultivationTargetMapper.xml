    <sql id="selectStandardCultivationTargetVo">
        select ct.id,
               ct.name,
               ct.code,
               ct.parent_id,
               ct.leaf,
               ct.level,
               ct.url,
               ct.college_id,
               ct.major_id,
               ct.sub_major_id,
               ct.class_id,
               ct.create_time,
               ct.creator,
               ct.last_modified_time,
               ct.last_modifier,
               ct.remark,
               ct.sysflag,
               ct.version,
               ct.category_id,
               m.name as majorName,
               sub_m.name as subMajorName,
               sc.name as categoryName
        from t_csys_std_cultivation_target ct
        left join t_csys_std_major m on ct.major_id=m.id
        left join t_csys_std_major sub_m on ct.sub_major_id=sub_m.id
        left join t_csys_training_scheme_category sc  on ct.category_id=sc.id
    </sql>


