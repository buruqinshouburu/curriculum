    <update id="updateStandardCultivationTargetList" parameterType="java.util.List">
        <foreach collection="standardCultivationTargetList" item="standardCultivationTarget" index="index"
                 separator=";">
            update t_csys_std_cultivation_target AS target
            set target.parent_id = #{standardCultivationTarget.parentId},
                target.url       = #{standardCultivationTarget.url},
                target.leaf      = #{standardCultivationTarget.leaf},
                target.level     = #{standardCultivationTarget.level}
