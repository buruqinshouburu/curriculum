    <select id="selectTargetPropUpBySchemeId" resultMap="StandardGraduationStatisticsVoResult">
        SELECT denominator.parent_id as denominator_id,
               denominator.count     as denominator_count,
               denominator.`name`    as denominator_name,
               numerator.count       as numerator_count
        FROM (SELECT t1.parent_id,
                     COUNT(t1.parent_id) AS count,
                     t2.`name`
              FROM t_csys_std_cultivation_target t1
                       JOIN t_csys_std_cultivation_target t2 ON t1.parent_id = t2.id
              WHERE t1.parent_id IN (
                  SELECT id
                  FROM t_csys_std_cultivation_target
                  WHERE sysflag = 0
                    AND FIND_IN_SET(
                          (
                              SELECT st.id
                              FROM t_csys_training_scheme s
                                       LEFT JOIN t_csys_std_cultivation sc ON s.standard_id = sc.id
                                       LEFT JOIN t_csys_std_graduation sg ON sc.graduation_id = sg.id
                                       LEFT JOIN t_csys_std_cultivation_target st ON sg.cultivation_target_id = st.id
                              WHERE s.id = #{schemeId}
                          ),
                          url
                      )
                    AND LEVEL = 2
              )
              GROUP BY t1.parent_id) as denominator
                 left JOIN
             (
                 SELECT a.parent_id,
                        COUNT(a.parent_id) as count
                 FROM (
                          SELECT st.id,
                                 st.`name`,
                                 st.url,
                                 st.parent_id
                          FROM t_csys_knowledge_unit_ref_std_cultivation urc
                                   LEFT JOIN t_csys_std_cultivation_ref_graduation crg
                                             ON urc.cultivation_id = crg.cultivation_id
                                   LEFT JOIN t_csys_std_graduation_ref_cultivation_target grt
                                             ON crg.graduation_id = grt.graduation_id
                                   LEFT JOIN t_csys_std_cultivation_target st ON grt.cultivation_target_id = st.id
                          WHERE urc.scheme_id = #{schemeId}
                          GROUP BY st.id
                      ) AS a
                 GROUP BY a.parent_id) as numerator
             on numerator.parent_id = denominator.parent_id
    </select>

