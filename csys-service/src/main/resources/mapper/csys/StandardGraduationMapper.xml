    <sql id="selectStandardGraduationVo">
        select g.id,
               g.name,
               g.code,
               g.parent_id,
               g.cultivation_target_id,
               g.leaf,
               g.level,
               g.url,
               g.college_id,
               g.major_id,
               g.sub_major_id,
               g.class_id,
               g.create_time,
               g.creator,
               g.last_modified_time,
               g.last_modifier,
               g.remark,
               g.sysflag,
               g.version,
               g.category_id,
               g.type,
               g.graduation_type,
               g.source_id,
               g.scheme_Id,
               g.education_Level,
               m.name as majorName,
               sub_m.name as subMajorName,
               sc.name as categoryName
        from t_csys_std_graduation g
                 left join t_csys_std_major m on g.major_id = m.id
                 left join t_csys_std_major sub_m on g.sub_major_id = sub_m.id
                 left join t_csys_training_scheme_category sc on g.category_id = sc.id
    </sql>
    <sql id="selectStandardGraduationRefTargetVo">
        SELECT sg.id,
               sg.`name`,
               sg.cultivation_target_id,
               sg.`code`,
               sg.parent_id,
               sg.leaf,
               sg.`level`,
               sg.url,
               sg.college_id,
               sg.major_id,
               sg.sub_major_id,
               sg.class_id,
               sg.remark,
               sg.version,
               grt.graduation_id,
               grt.cultivation_target_id ref_t_id,
               sg.category_id,
               sg.type,
               sg.graduation_type,
               sg.source_id,
               sg.scheme_Id
        FROM t_csys_std_graduation sg
                 LEFT JOIN t_csys_std_graduation_ref_cultivation_target grt ON sg.id = grt.graduation_id
    </sql>

