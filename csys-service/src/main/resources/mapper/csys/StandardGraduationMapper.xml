        SELECT *
        FROM t_csys_std_graduation_ref_cultivation_target grc
        LEFT JOIN t_csys_std_graduation sg
        on grc.graduation_id = sg.id
        WHERE sg.sysflag = 0
        and grc.cultivation_target_id =#{targetId}
    </select>

    <select id="selectStandardGraduationByRoot" resultMap="StandardGraduationResult">
        <include refid="selectStandardGraduationVo"/>
        where g.sysflag = 0
        and find_in_set(#{id}, g.url)
        and g.name = #{name}
        and g.leaf = 1
    </select>

    <delete id="deleteByIds">
        delete from t_csys_std_graduation
        <where>
            id in
            <foreach collection="ids" separator="," open="(" close=")" item="id">
                #{id}
            </foreach>
        </where>
    </delete>

    <select id="selectStandardGraduationByMajorId" resultMap="StandardGraduationResult">
        select * from t_csys_std_graduation where major_id=#{trainingSchemeVo.majorId} and version=#{trainingSchemeVo.version} and sysflag=0;
    </select>

    <delete id="deleteStandardGraduationBySchemeId">
        delete from t_csys_std_graduation where scheme_Id=#{schemeId}
    </delete>
</mapper>