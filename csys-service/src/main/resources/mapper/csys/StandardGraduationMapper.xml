    <insert id="insertStandardGraduationList" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        insert into t_csys_std_graduation (name, code, parent_id, leaf, level, url, cultivation_target_id, major_id, sub_major_id, class_id, college_id, remark,version,category_id,graduation_Type,creator,type,scheme_Id,education_level) VALUES
        <foreach collection="standardGraduationList" item="standardGraduation" separator=",">
            (#{standardGraduation.name}, #{standardGraduation.code},
             #{standardGraduation.parentId}, #{standardGraduation.leaf},
             #{standardGraduation.level}, #{standardGraduation.url}, #{standardGraduation.cultivationTargetId},
            #{standardGraduation.majorId}, #{standardGraduation.subMajorId}, #{standardGraduation.classId},
             #{standardGraduation.collegeId}, #{standardGraduation.remark}, #{standardGraduation.version},#{standardGraduation.categoryId},#{standardGraduation.graduationType},#{standardGraduation.creator},#{standardGraduation.type},#{standardGraduation.schemeId},#{standardGraduation.educationLevel})
        </foreach>
    </insert>

    <update id="updateStandardGraduationList" parameterType="java.util.List">
        <foreach collection="standardGraduationList" item="standardGraduation" index="index" separator=";">
            update t_csys_std_graduation AS graduation
            set graduation.parent_id = #{standardGraduation.parentId},
                graduation.url       = #{standardGraduation.url},
                graduation.cultivation_target_id       = #{standardGraduation.cultivationTargetId},
                graduation.leaf      = #{standardGraduation.leaf},
                graduation.level     = #{standardGraduation.level}
            where graduation.id = #{standardGraduation.id}
        </foreach>
    </update>

    <update id="deleteStandardGraduation">
        UPDATE t_csys_std_graduation
        SET sysflag = 2
        WHERE id = #{id}
           or FIND_IN_SET(#{id}, url)
    </update>

    <update id="setLeafIsNode">
        update t_csys_std_graduation
        set leaf = 1
        where id = #{pId}
