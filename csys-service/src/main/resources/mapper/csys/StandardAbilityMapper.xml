    <select id="selectStandardAbilityListBySchemeId" resultType="java.util.Map">
        select g.id, g.name, count(distinct sg.id) as pointNum
        from t_csys_std_graduation g
                 left join t_csys_std_graduation sg on sg.parent_id = g.id
        where g.type = #{type}
          and g.level = 2
          and g.scheme_Id=#{schemeId}
        group by  g.id, g.name
    </select>
