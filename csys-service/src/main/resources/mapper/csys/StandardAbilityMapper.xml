    <update id="deleteStandardAbilityById" parameterType="Long">
        update t_csys_std_ability
        set sysflag = 2
        WHERE id = #{id}
           or FIND_IN_SET(#{id}, url)
    </update>

    <update id="deleteStandardAbilityByIds" parameterType="String">
        update t_csys_std_ability
        set sysflag = 2 where
        <foreach item="id" collection="array" open="(" separator="or" close=")">
            (FIND_IN_SET(#{id}, url) or id = #{id})
        </foreach>
    </update>

