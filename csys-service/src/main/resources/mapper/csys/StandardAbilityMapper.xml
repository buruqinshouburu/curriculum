                                        class_id, college_id, remark, version) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.name}, #{item.code},
             #{item.parentId}, #{item.leaf},
             #{item.type}, #{item.level},
             #{item.url}, #{item.majorId},
             #{item.subMajorId}, #{item.classId},
             #{item.collegeId}, #{item.remark}, #{item.version})
        </foreach>
    </insert>

