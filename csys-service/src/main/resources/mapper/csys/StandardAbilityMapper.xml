    <sql id="selectStandardAbilityVo">
        select `name`,
               id,
               parent_id,
               url,
               level,
               leaf,
               type,
               `code`,
               college_id,
               major_id,
               sub_major_id,
               category_Id,
               class_id,
               create_time,
               creator,
               last_modified_time,
               last_modifier,
               remark,
               sysflag,
               version
        from t_csys_std_ability
    </sql>

    <select id="selectStandardAbilityList" parameterType="com.doinner.csys.domain.StandardAbility"
            resultMap="StandardAbilityResult">
        select ability.name,
               ability.id,
               ability.parent_id,
               ability.url,
               ability.level,
               ability.leaf,
               ability.type,
               ability.code,
               ability.college_id,
               ability.major_id,
               ability.sub_major_id,
               ability.class_id,
               ability.create_time,
               ability.creator,
               ability.last_modified_time,
               ability.last_modifier,
               ability.remark,
               ability.sysflag,
               ability.version,
               ability.source_id as                                                            sourceId,
               (select name from t_csys_std_major major where major.id = ability.major_id)     major_name,
               (select name from t_csys_std_major major where major.id = ability.sub_Major_Id) sub_Major_Name,
               category.id                                                                     category_id,
               category.name                                                                   category_name
        from t_csys_std_ability ability
                 left join t_csys_training_scheme_category category
                           on ability.category_id = category.id
        where ability.sysflag = 0
        <if test="name != null  and name != ''">
            and ability.name like concat('%', #{name}, '%')
        </if>
        <if test="parentId != null">
            and ability.parent_id = #{parentId}
        </if>
        <if test="type != null">
            and ability.type = #{type}
        </if>
        <if test="version != null">
            and ability.version = #{version}
        </if>
        <if test="code != null  and code != ''">
            and ability.code = #{code}
        </if>
        <if test="collegeId != null">
            and ability.college_id = #{collegeId}
        </if>
        <if test="majorId != null">
            and ability.major_id = #{majorId}
        </if>
        <if test="subMajorId != null">
            and ability.sub_major_id = #{subMajorId}
        </if>
        <if test="categoryId != null">
            and ability.category_Id = #{categoryId}
        </if>
        <if test="classId != null">
            and ability.class_id = #{classId}
        </if>
        <if test="creator != null  and creator != ''">
            and ability.creator = #{creator}
        </if>
        order by ability.create_time desc
    </select>

