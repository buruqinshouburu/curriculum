<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doinner.csys.dao.TeachingPlanMapper">

    <resultMap id="BaseResultMap" type="com.doinner.csys.domain.TeachingPlan">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="root_plan_id" property="rootPlanId" jdbcType="BIGINT"/>
        <result column="source_course_id" property="sourceCourseId" jdbcType="BIGINT"/>
        <result column="plan_type" property="planType" jdbcType="TINYINT"/>
        <result column="version" property="version" jdbcType="VARCHAR"/>
        <result column="current_flag" property="currentFlag" jdbcType="TINYINT"/>
        <result column="enabled_term" property="enabledTerm" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="source_course_name" property="sourceCourseName" jdbcType="VARCHAR"/>
        <result column="source_course_code" property="sourceCourseCode" jdbcType="VARCHAR"/>
        <result column="source_course_en_name" property="sourceCourseEnName" jdbcType="VARCHAR"/>
        <result column="source_hours" property="sourceHours" jdbcType="DECIMAL"/>
        <result column="source_teach_hours" property="sourceTeachHours" jdbcType="DECIMAL"/>
        <result column="source_practice_hours" property="sourcePracticeHours" jdbcType="DECIMAL"/>
        <result column="source_credit" property="sourceCredit" jdbcType="DECIMAL"/>
        <result column="score_rule" property="scoreRule" jdbcType="LONGVARCHAR"/>
        <result column="file_id" property="fileId" jdbcType="VARCHAR"/>
        <result column="file_name" property="fileName" jdbcType="VARCHAR"/>
        <result column="download_url" property="downloadUrl" jdbcType="VARCHAR"/>
        <result column="preview_url" property="previewUrl" jdbcType="VARCHAR"/>
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="last_modifier" property="lastModifier" jdbcType="VARCHAR"/>
        <result column="last_modified_time" property="lastModifiedTime" jdbcType="TIMESTAMP"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="sysflag" property="sysflag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, root_plan_id, source_course_id, plan_type, version, current_flag, enabled_term, status,
        source_course_name, source_course_code, source_course_en_name, source_hours, source_teach_hours,
        source_practice_hours, source_credit, score_rule, file_id, file_name, download_url, preview_url,
        creator, create_time, last_modifier, last_modified_time, remark, sysflag
    </sql>

    <insert id="insert" parameterType="com.doinner.csys.domain.TeachingPlan"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_csys_teaching_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="rootPlanId != null">root_plan_id,</if>
            <if test="sourceCourseId != null">source_course_id,</if>
            <if test="planType != null">plan_type,</if>
            <if test="version != null">version,</if>
            <if test="currentFlag != null">current_flag,</if>
            <if test="enabledTerm != null">enabled_term,</if>
            <if test="status != null">status,</if>
            <if test="sourceCourseName != null">source_course_name,</if>
            <if test="sourceCourseCode != null">source_course_code,</if>
            <if test="sourceCourseEnName != null">source_course_en_name,</if>
            <if test="sourceHours != null">source_hours,</if>
            <if test="sourceTeachHours != null">source_teach_hours,</if>
            <if test="sourcePracticeHours != null">source_practice_hours,</if>
            <if test="sourceCredit != null">source_credit,</if>
            <if test="scoreRule != null">score_rule,</if>
            <if test="fileId != null">file_id,</if>
            <if test="fileName != null">file_name,</if>
            <if test="downloadUrl != null">download_url,</if>
            <if test="previewUrl != null">preview_url,</if>
            <if test="creator != null">creator,</if>
            <if test="createTime != null">create_time,</if>
            <if test="lastModifier != null">last_modifier,</if>
            <if test="lastModifiedTime != null">last_modified_time,</if>
            <if test="remark != null">remark,</if>
            <if test="sysflag != null">sysflag,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="rootPlanId != null">#{rootPlanId},</if>
            <if test="sourceCourseId != null">#{sourceCourseId},</if>
            <if test="planType != null">#{planType},</if>
            <if test="version != null">#{version},</if>
            <if test="currentFlag != null">#{currentFlag},</if>
            <if test="enabledTerm != null">#{enabledTerm},</if>
            <if test="status != null">#{status},</if>
            <if test="sourceCourseName != null">#{sourceCourseName},</if>
            <if test="sourceCourseCode != null">#{sourceCourseCode},</if>
            <if test="sourceCourseEnName != null">#{sourceCourseEnName},</if>
            <if test="sourceHours != null">#{sourceHours},</if>
            <if test="sourceTeachHours != null">#{sourceTeachHours},</if>
            <if test="sourcePracticeHours != null">#{sourcePracticeHours},</if>
            <if test="sourceCredit != null">#{sourceCredit},</if>
            <if test="scoreRule != null">#{scoreRule},</if>
            <if test="fileId != null">#{fileId},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="downloadUrl != null">#{downloadUrl},</if>
            <if test="previewUrl != null">#{previewUrl},</if>
            <if test="creator != null">#{creator},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="lastModifier != null">#{lastModifier},</if>
            <if test="lastModifiedTime != null">#{lastModifiedTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="sysflag != null">#{sysflag},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.doinner.csys.domain.TeachingPlan">
        UPDATE t_csys_teaching_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="rootPlanId != null">root_plan_id = #{rootPlanId},</if>
            <if test="sourceCourseId != null">source_course_id = #{sourceCourseId},</if>
            <if test="planType != null">plan_type = #{planType},</if>
            <if test="version != null">version = #{version},</if>
            <if test="currentFlag != null">current_flag = #{currentFlag},</if>
            <if test="enabledTerm != null">enabled_term = #{enabledTerm},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sourceCourseName != null">source_course_name = #{sourceCourseName},</if>
            <if test="sourceCourseCode != null">source_course_code = #{sourceCourseCode},</if>
            <if test="sourceCourseEnName != null">source_course_en_name = #{sourceCourseEnName},</if>
            <if test="sourceHours != null">source_hours = #{sourceHours},</if>
            <if test="sourceTeachHours != null">source_teach_hours = #{sourceTeachHours},</if>
            <if test="sourcePracticeHours != null">source_practice_hours = #{sourcePracticeHours},</if>
            <if test="sourceCredit != null">source_credit = #{sourceCredit},</if>
            <if test="scoreRule != null">score_rule = #{scoreRule},</if>
            <if test="fileId != null">file_id = #{fileId},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="downloadUrl != null">download_url = #{downloadUrl},</if>
            <if test="previewUrl != null">preview_url = #{previewUrl},</if>
            <if test="lastModifier != null">last_modifier = #{lastModifier},</if>
            <if test="lastModifiedTime != null">last_modified_time = #{lastModifiedTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_csys_teaching_plan
        WHERE id = #{id}
          AND sysflag = 0
    </select>

    <select id="selectBySourceCourseId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_csys_teaching_plan
        WHERE source_course_id = #{sourceCourseId}
          AND current_flag = 1
          AND sysflag = 0
        ORDER BY id DESC
        LIMIT 1
    </select>

    <select id="selectList" parameterType="com.doinner.csys.domain.TeachingPlan" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_csys_teaching_plan
        <where>
            sysflag = 0
            <if test="sourceCourseId != null">AND source_course_id = #{sourceCourseId}</if>
            <if test="planType != null">AND plan_type = #{planType}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="currentFlag != null">AND current_flag = #{currentFlag}</if>
        </where>
        ORDER BY id DESC
    </select>

    <update id="deleteById">
        UPDATE t_csys_teaching_plan SET sysflag = 2 WHERE id = #{id}
    </update>

    <!-- 课程教学计划管理列表返回行映射 -->
    <resultMap id="TeachingPlanListResult" type="com.doinner.csys.domain.vo.TeachingPlanListVo">
        <result column="course_id" property="courseId" jdbcType="BIGINT"/>
        <result column="course_name" property="courseName" jdbcType="VARCHAR"/>
        <result column="course_code" property="courseCode" jdbcType="VARCHAR"/>
        <result column="teach_college_id" property="teachCollegeId" jdbcType="BIGINT"/>
        <result column="education_level" property="educationLevel" jdbcType="VARCHAR"/>
        <result column="course_module" property="courseModule" jdbcType="VARCHAR"/>
        <result column="course_module_name" property="courseModuleName" jdbcType="VARCHAR"/>
        <result column="course_attr" property="courseAttr" jdbcType="VARCHAR"/>
        <result column="major_id" property="majorId" jdbcType="BIGINT"/>
        <result column="hours" property="hours" jdbcType="DOUBLE"/>
        <result column="credit" property="credit" jdbcType="DOUBLE"/>
        <result column="teaching_plan_id" property="teachingPlanId" jdbcType="BIGINT"/>
        <result column="plan_type" property="planType" jdbcType="TINYINT"/>
        <result column="plan_version" property="planVersion" jdbcType="VARCHAR"/>
        <result column="current_flag" property="currentFlag" jdbcType="TINYINT"/>
        <result column="enabled_term" property="enabledTerm" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="file_id" property="fileId" jdbcType="VARCHAR"/>
        <result column="file_name" property="fileName" jdbcType="VARCHAR"/>
        <result column="source_credit" property="sourceCredit" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 课程教学计划管理列表：以总库课程为主表(source_id is null)，left join 教学计划表 -->
    <select id="selectTeachingPlanPage" parameterType="com.doinner.csys.domain.vo.TeachingPlanQueryVo"
            resultMap="TeachingPlanListResult">
        SELECT
            course.id                    AS course_id,
            course.name                  AS course_name,
            course.code                  AS course_code,
            course.teach_college_id      AS teach_college_id,
            course.education_level       AS education_level,
            course.course_Module         AS course_module,
            course.course_Module_Children AS course_module_name,
            course.course_attr           AS course_attr,
            course.major_Id              AS major_id,
            course.hours                 AS hours,
            course.credit                AS credit,
            plan.id                      AS teaching_plan_id,
            plan.plan_type               AS plan_type,
            plan.version                 AS plan_version,
            plan.current_flag            AS current_flag,
            plan.enabled_term            AS enabled_term,
            plan.status                  AS status,
            plan.file_id                 AS file_id,
            plan.file_name               AS file_name,
            plan.source_credit           AS source_credit
        FROM t_csys_course course
        LEFT JOIN t_csys_teaching_plan plan
            ON course.id = plan.source_course_id
            AND plan.sysflag = 0
            AND plan.current_flag = 1
        <where>
            course.source_id IS NULL
            AND course.sysflag = 0
            <if test="courseName != null and courseName != ''">
                AND course.name LIKE CONCAT('%', #{courseName}, '%')
            </if>
            <if test="courseCode != null and courseCode != ''">
                AND course.code LIKE CONCAT('%', #{courseCode}, '%')
            </if>
            <if test="teachCollegeId != null">
                AND course.teach_college_id = #{teachCollegeId}
            </if>
            <if test="educationLevel != null and educationLevel != ''">
                AND course.education_level = #{educationLevel}
            </if>
            <if test="courseModule != null and courseModule != ''">
                AND course.course_Module = #{courseModule}
            </if>
            <if test="courseAttr != null and courseAttr != ''">
                AND course.course_attr = #{courseAttr}
            </if>
        </where>
        ORDER BY course.id DESC
    </select>

    <!-- 教学计划详情返回行映射 -->
    <resultMap id="TeachingPlanDetailResult" type="com.doinner.csys.domain.vo.TeachingPlanDetailVo">
        <result column="course_id" property="courseId" jdbcType="BIGINT"/>
        <result column="teaching_plan_id" property="teachingPlanId" jdbcType="BIGINT"/>
        <result column="course_name" property="courseName" jdbcType="VARCHAR"/>
        <result column="course_code" property="courseCode" jdbcType="VARCHAR"/>
        <result column="course_en_name" property="courseEnName" jdbcType="VARCHAR"/>
        <result column="enabled_term" property="enabledTerm" jdbcType="VARCHAR"/>
        <result column="education_level" property="educationLevel" jdbcType="VARCHAR"/>
        <result column="term" property="term" jdbcType="VARCHAR"/>
        <result column="course_module" property="courseModule" jdbcType="VARCHAR"/>
        <result column="major_id" property="majorId" jdbcType="BIGINT"/>
        <result column="course_attr" property="courseAttr" jdbcType="VARCHAR"/>
        <result column="teach_hours" property="teachHours" jdbcType="DECIMAL"/>
        <result column="practice_hours" property="practiceHours" jdbcType="DECIMAL"/>
        <result column="hours" property="hours" jdbcType="DECIMAL"/>
        <result column="credit" property="credit" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 详情-课程分支：教学计划id为空时，全部取自总库课程 -->
    <select id="selectDetailByCourseId" resultMap="TeachingPlanDetailResult">
        SELECT
            course.id              AS course_id,
            NULL                   AS teaching_plan_id,
            course.name            AS course_name,
            course.code            AS course_code,
            course.en_name         AS course_en_name,
            NULL                   AS enabled_term,
            course.education_level AS education_level,
            course.open_term       AS term,
            course.course_Module   AS course_module,
            course.major_Id        AS major_id,
            course.course_attr     AS course_attr,
            course.teach_hours     AS teach_hours,
            course.practice_hours  AS practice_hours,
            course.hours           AS hours,
            course.credit          AS credit
        FROM t_csys_course course
        WHERE course.id = #{courseId}
          AND course.sysflag = 0
    </select>

    <!-- 详情-计划分支：教学计划id存在时，基础信息取自教学计划表，其余取自调用课程上下文 -->
    <select id="selectDetailByPlanId" resultMap="TeachingPlanDetailResult">
        SELECT
            plan.source_course_id  AS course_id,
            plan.id                AS teaching_plan_id,
            plan.source_course_name AS course_name,
            plan.source_course_code AS course_code,
            plan.source_course_en_name AS course_en_name,
            plan.enabled_term      AS enabled_term,
            ctx.education_level    AS education_level,
            ctx.term               AS term,
            ctx.course_module      AS course_module,
            ctx.major_id           AS major_id,
            ctx.course_attr        AS course_attr,
            ctx.teach_hours        AS teach_hours,
            ctx.practice_hours     AS practice_hours,
            ctx.hours              AS hours,
            ctx.credits            AS credit
        FROM t_csys_teaching_plan plan
        LEFT JOIN t_csys_teaching_plan_context ctx
            ON ctx.plan_id = plan.id
            AND ctx.sysflag = 0
            AND ctx.sync_flag = 1
        WHERE plan.id = #{teachingPlanId}
          AND plan.sysflag = 0
        ORDER BY ctx.sort ASC, ctx.id ASC
        LIMIT 1
    </select>
</mapper>
