<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doinner.csys.dao.AbilityRefGraduationMapper">


    <select id="selectByAbilityId" parameterType="Long" resultType="com.doinner.csys.domain.AbilityRefGraduation">
        select ability_id abilityId, graduation_id graduationId
            from t_csys_std_ability_ref_graduation
        <where>
            <if test="abilityId != null">
                and ability_id = #{abilityId}
            </if>
        </where>
    </select>


    <insert id="insert" parameterType="CourseRefAbility">
        insert into t_csys_std_ability_ref_graduation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="abilityId != null">
                ability_id,
            </if>
            <if test="graduationId != null">
                graduation_id,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="abilityId != null">
                #{abilityId},
            </if>
            <if test="graduationId != null">
                #{graduationId},
            </if>
        </trim>
    </insert>


    <delete id="deleteByAbilityId" parameterType="Long">
        delete
        from t_csys_std_ability_ref_graduation where ability_id = #{abilityId}
    </delete>


    <delete id="deleteByAbilityIds" parameterType="String">
        delete
            from t_csys_std_ability_ref_graduation where ability_id in
        <foreach item="abilityId" collection="abilityIds" open="(" separator="," close=")">
            #{abilityId}
        </foreach>
    </delete>

</mapper>
