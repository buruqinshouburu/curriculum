    <delete id="deleteTrainingSchemeCourseScheduleByIds" parameterType="String">
        delete
        from t_csys_training_scheme_course_schedule where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteTrainingSchemeCourseScheduleByTrainingSchemeId" parameterType="Long">
        delete
        from t_csys_training_scheme_course_schedule
        where scheme_id = #{trainingSchemeId}
    </delete>

    <delete id="deleteTrainingSchemeCourseScheduleByTrainingSchemeIds" parameterType="Long">
        delete
        from t_csys_training_scheme_course_schedule
        where scheme_id in
        <foreach item="schemeId" collection="array" open="(" separator="," close=")">
            #{schemeId}
        </foreach>
    </delete>

    <select id="selectHoursBySchemeId" resultMap="TrainingSchemeCourseScheduleStatisticsVoResult">
        SELECT sc.scheme_id,
               sc.theory_hours   AS s_theory_hours,
               sc.teach_hours   AS s_teach_hours,
               sc.practice_hours AS s_practice_hours,
               c.id              as course_id,
               c.theory_hours    as c_theory_hours,
               c.teach_hours    as c_teach_hours,
               c.practice_hours  as c_practice_hours,
               sc.term
        FROM t_csys_training_scheme_course_schedule sc
                 LEFT JOIN t_csys_course c ON sc.course_id = c.id
        WHERE sc.scheme_id = #{schemeId}
        and sc.checked = 1
    </select>

    <select id="selectHoursBySchemeIds" parameterType="Long" resultMap="TrainingSchemeCourseScheduleStatisticsVoResult">
        SELECT sc.scheme_id,
               sc.theory_hours   AS s_theory_hours,
               sc.teach_hours   AS s_teach_hours,
               sc.practice_hours AS s_practice_hours,
               c.id              as course_id,
               c.theory_hours    as c_theory_hours,
               c.teach_hours    as c_teach_hours,
               c.practice_hours  as c_practice_hours,
               sc.term
        FROM t_csys_training_scheme_course_schedule sc
                 LEFT JOIN t_csys_course c ON sc.course_id = c.id
        WHERE sc.scheme_id in
        <foreach item="schemeId" collection="schemeIds" open="(" separator="," close=")">
            #{schemeId}
        </foreach>
        and sc.checked = 1
    </select>

    <select id="selectCourseTypeBySchemeId" resultMap="StandardGraduationStatisticsVoResult">
        SELECT type        as denominator_id,
               count(type) as numerator_count
        FROM t_csys_training_scheme_course_schedule
        WHERE scheme_id = #{schemeId}
        GROUP BY type
        ORDER BY type
    </select>

    <select id="selectCourseTypeBySchemeIds" parameterType="Long" resultMap="StandardGraduationStatisticsVoResult">
        SELECT type        as denominator_id,
               count(type) as numerator_count
        FROM t_csys_training_scheme_course_schedule
        WHERE scheme_id in
        <foreach item="schemeId" collection="schemeIds" open="(" separator="," close=")">
            #{schemeId}
        </foreach>
        GROUP BY type
        ORDER BY type
    </select>

    <delete id="deleteByCourseIds">
        delete from t_csys_training_scheme_course_schedule
        where course_id in
        <foreach item="courseId" collection="ids" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

    <!-- 按课程id集合查询排课明细(用于历史 6/7 课程刷新取数) -->
    <select id="selectByCourseIds" resultMap="TrainingSchemeCourseScheduleResult">
        select course_id, term, teach_hours, practice_hours
        from t_csys_training_scheme_course_schedule
        where sysflag = 0
        and course_id in
        <foreach item="courseId" collection="courseIds" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </select>

    <resultMap type="com.doinner.csys.domain.vo.CourseChooseStatusVo" id="CourseChooseStatusVoResult">
        <result property="sourceCourseId" column="source_course_id"/>
        <result property="courseId" column="course_id"/>
        <result property="courseName" column="course_name"/>
        <result property="courseCode" column="course_code"/>
        <result property="schemeId" column="scheme_id"/>
        <result property="term" column="term"/>
        <result property="teachHours" column="teach_hours"/>
        <result property="practiceHours" column="practice_hours"/>
        <result property="collegeName" column="college_name"/>
        <result property="categoryName" column="category_name"/>
        <result property="majorName" column="major_name"/>
    </resultMap>

    <!--
        查询课程被选用情况(用于"课程被选用情况表"导出)。
        入参为源课程ID集合；通过 source_id 定位被选用课程(c2)，c2 即被各培养方案引用排课的课程实例。
        课程名称/编号取自源课程(cs)；选用单位(学院)/选用专业类/选用专业均取自排课所属培养方案(ts)的
        college_id / category_id / major_id 关联字段；学期学时取自 c2 的排课记录(tcs)。
    -->
    <select id="selectCourseChooseStatus" resultMap="CourseChooseStatusVoResult">
        select c2.source_id as source_course_id,
        cs.name as course_name,
        cs.code as course_code,
        c2.id as course_id,
        tcs.scheme_id as scheme_id,
        tcs.term as term,
        tcs.teach_hours as teach_hours,
        tcs.practice_hours as practice_hours,
        cd.dept_name as college_name,
        tsc.name as category_name,
        major_tab.name as major_name
        from t_csys_course c2
        left join t_csys_course cs on cs.id = c2.source_id
        left join t_csys_training_scheme_course_schedule tcs on tcs.course_id = c2.id
        left join t_csys_training_scheme ts on ts.id = tcs.scheme_id
        left join sys_dept cd on cd.dept_id = ts.college_id and cd.del_flag = 0
        left join t_csys_std_major tsc on tsc.id = ts.major_id
        left join (select group_concat(m.name separator '、') as name,srm.scheme_id from t_csys_std_major m inner join
        t_csys_scheme_ref_major srm on m.id = srm.major_id group by srm.scheme_id) major_tab
        on major_tab.scheme_id=ts.id
        where c2.source_id in
        <foreach item="sourceCourseId" collection="sourceCourseIds" open="(" separator="," close=")">
            #{sourceCourseId}
        </foreach>
        and c2.sysflag = 0
        order by c2.source_id, c2.id, tcs.term
    </select>
</mapper>