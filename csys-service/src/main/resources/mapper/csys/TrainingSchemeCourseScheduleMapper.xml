    <insert id="insertTrainingSchemeCourseSchedules">
        insert into t_csys_training_scheme_course_schedule
        (scheme_id, course_id, type, term, hours, theory_hours, teach_hours,practice_hours, checked,course_attr,credits) values
        <foreach collection="trainingSchemeCourseSchedules" item="trainingSchemeCourseSchedule" separator=",">
            (#{trainingSchemeCourseSchedule.schemeId},
             #{trainingSchemeCourseSchedule.courseId},
             #{trainingSchemeCourseSchedule.type},
             #{trainingSchemeCourseSchedule.term},
             #{trainingSchemeCourseSchedule.hours},
             #{trainingSchemeCourseSchedule.theoryHours},
             #{trainingSchemeCourseSchedule.teachHours},
             #{trainingSchemeCourseSchedule.practiceHours},
             #{trainingSchemeCourseSchedule.checked},
            #{trainingSchemeCourseSchedule.courseAttr},
            #{trainingSchemeCourseSchedule.credits})
        </foreach>
    </insert>

