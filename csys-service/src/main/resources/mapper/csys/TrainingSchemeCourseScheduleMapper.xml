    <sql id="selectTrainingSchemeCourseScheduleVo">
        select tcs.*,
               c.name             as course_name,
               c.before_course_id as c_before,
               c.after_course_id  as c_after,
               c.course_attr,
               c.type             as c_type,
               c.time_Week,
               c.unit,
               c.source_id,
               c.academic_terms_number as academicTermsNumber,
               c.semester_Schedule as semesterSchedule
        from t_csys_training_scheme_course_schedule tcs
                 left join t_csys_course c ON c.id = tcs.course_id
    </sql>

    <select id="selectTrainingSchemeCourseScheduleList"
            parameterType="com.doinner.csys.domain.TrainingSchemeCourseSchedule"
            resultMap="TrainingSchemeCourseScheduleVoResult">
        <include refid="selectTrainingSchemeCourseScheduleVo"/>
        <where>
            <if test="schemeId != null">
                and tcs.scheme_id = #{schemeId}
            </if>
            <if test="courseId != null">
                and tcs.course_id = #{courseId}
            </if>
            <if test="type != null">
                and tcs.type = #{type}
            </if>
            <if test="term != null">
                and tcs.term = #{term}
            </if>
            <if test="hours != null">
                and tcs.hours = #{hours}
            </if>
            <if test="theoryHours != null">
                and tcs.theory_hours = #{theoryHours}
            </if>
            <if test="teachHours != null">
                and tcs.teach_hours = #{teachHours}
            </if>
            <if test="practiceHours != null">
                and tcs.practice_hours = #{practiceHours}
            </if>
            <if test="checked != null">
                and tcs.checked = #{checked}
            </if>
            <if test="creator != null  and creator != ''">
                and tcs.creator = #{creator}
            </if>
            <if test="subMajorId!=null and subMajorId!=''">
                and (c.sub_Major_Id=#{subMajorId} or c.sub_Major_Id is null)
            </if>
        </where>
    </select>

    <select id="selectTrainingSchemeCourseScheduleById" parameterType="Long"
            resultMap="TrainingSchemeCourseScheduleVoResult">
        <include refid="selectTrainingSchemeCourseScheduleVo"/>
        where tcs.id = #{id}
    </select>

