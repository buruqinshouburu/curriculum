<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doinner.csys.dao.SchemeDetailMapper">

    <resultMap type="SchemeDetail" id="SchemeDetailResult">
        <result property="id" column="id"/>
        <result property="schemeId" column="scheme_id"/>
        <result property="category" column="category"/>
        <result property="name" column="name"/>
        <result property="time" column="time"/>
        <result property="credit" column="credit"/>
        <result property="semester" column="semester"/>
        <result property="remark" column="remark"/>
        <result property="sort" column="sort"/>
    </resultMap>

    <sql id="selectSchemeDetailVo">
        select id, scheme_id, category, name, time, credit, semester, remark,sort
        from t_csys_scheme_detail
    </sql>

    <select id="selectSchemeDetailList" parameterType="SchemeDetail" resultMap="SchemeDetailResult">
        <include refid="selectSchemeDetailVo"/>
        <where>
            <if test="schemeId != null ">
                and scheme_id = #{schemeId}
            </if>
            <if test="category != null  and category != ''">
                and category = #{category}
            </if>
            <if test="name != null  and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="time != null  and time != ''">
                and time = #{time}
            </if>
            <if test="credit != null  and credit != ''">
                and credit = #{credit}
            </if>
            <if test="semester != null  and semester != ''">
                and semester = #{semester}
            </if>
        </where>
    </select>

    <select id="selectSchemeIdDetailList" parameterType="Long" resultMap="SchemeDetailResult">
        <include refid="selectSchemeDetailVo"/>
        <where>
            <if test="schemeId != null ">
                and scheme_id = #{schemeId}
            </if>
        </where>
    </select>

    <select id="selectSchemeDetailById" parameterType="Long"
            resultMap="SchemeDetailResult">
        <include refid="selectSchemeDetailVo"/>
        where id = #{id}
    </select>

    <insert id="insertSchemeDetail" parameterType="SchemeDetail" useGeneratedKeys="true"
            keyProperty="id">
        insert into t_csys_scheme_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="schemeId != null">scheme_id,
            </if>
            <if test="category != null">category,
            </if>
            <if test="name != null">name,
            </if>
            <if test="time != null">time,
            </if>
            <if test="credit != null">credit,
            </if>
            <if test="semester != null">semester,
            </if>
            <if test="remark != null">remark,
            </if>
            <if test="sort != null">sort,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="schemeId != null">#{schemeId},
            </if>
            <if test="category != null">#{category},
            </if>
            <if test="name != null">#{name},
            </if>
            <if test="time != null">#{time},
            </if>
            <if test="credit != null">#{credit},
            </if>
            <if test="semester != null">#{semester},
            </if>
            <if test="remark != null">#{remark},
            </if>
            <if test="sort != null">#{sort},
            </if>
        </trim>
    </insert>

    <update id="updateSchemeDetail" parameterType="SchemeDetail">
        update t_csys_scheme_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="schemeId != null">scheme_id =
                #{schemeId},
            </if>
            <if test="category != null">category =
                #{category},
            </if>
            <if test="name != null">name =
                #{name},
            </if>
            <if test="time != null">time =
                #{time},
            </if>
            <if test="credit != null">credit =
                #{credit},
            </if>
            <if test="semester != null">semester =
                #{semester},
            </if>
            <if test="remark != null">remark =
                #{remark},
            </if>
            <if test="sort != null">sort =
                #{sort},
            </if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSchemeDetailById" parameterType="Long">
        delete
        from t_csys_scheme_detail where id = #{id}
    </delete>

    <delete id="deleteSchemeDetailByIds" parameterType="Long">
        delete from t_csys_scheme_detail where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteSchemeDetailBySchemeId" parameterType="Long">
        delete
        from t_csys_scheme_detail where scheme_Id = #{schemeId}
    </delete>
</mapper>
